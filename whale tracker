function jitter(base, pct = 0.005) {
  return (base * (1 + (Math.random() - 0.5) * pct)).toFixed(2);
}

function updateTickers() {
  TICKERS.forEach(t => {
    if (t.sym.includes('/')) return;
    const base = parseFloat(t.price.replace(/,/g,''));
    const newP = jitter(base, 0.003);
    const diff = ((newP - base) / base * 100);
    const wasUp = t.up;
    t.price = parseFloat(newP).toFixed(2);
    t.chg = `${diff >= 0 ? '+' : ''}${diff.toFixed(2)}%`;
    t.up = diff >= 0;
  });
  renderTicker();
}

