<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LEVIATHAN — Whale Intelligence Trading System</title>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@300;400;600&family=Space+Grotesk:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #020508;
    --surface: #050d14;
    --card: #071420;
    --border: #0d2a40;
    --accent: #00d4ff;
    --accent2: #00ff9d;
    --accent3: #ff6b35;
    --warn: #ffd700;
    --red: #ff3b5c;
    --green: #00ff9d;
    --text: #e0f4ff;
    --muted: #4a7a99;
    --font-display: 'Bebas Neue', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
    --font-body: 'Space Grotesk', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* Animated background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: 
      radial-gradient(ellipse 80% 50% at 20% 10%, rgba(0,212,255,0.04) 0%, transparent 60%),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(0,255,157,0.03) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  .scanline {
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.15) 2px,
      rgba(0,0,0,0.15) 4px
    );
    pointer-events: none;
    z-index: 1;
    opacity: 0.3;
  }

  .container { position: relative; z-index: 2; max-width: 1600px; margin: 0 auto; padding: 0 16px; }

  /* HEADER */
  header {
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    background: rgba(5,13,20,0.95);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .logo-mark {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
    animation: pulse 3s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { filter: drop-shadow(0 0 8px rgba(0,212,255,0.6)); }
    50% { filter: drop-shadow(0 0 20px rgba(0,212,255,1)); }
  }

  .logo-text { font-family: var(--font-display); font-size: 28px; letter-spacing: 4px; color: var(--accent); }
  .logo-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; }

  .status-bar {
    display: flex;
    gap: 20px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }

  .status-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--green);
    animation: blink 1.5s ease-in-out infinite;
  }

  .status-dot.warn { background: var(--warn); }
  .status-dot.red { background: var(--red); }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  .live-time {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 2px;
  }

  /* MAIN GRID */
  .main-grid {
    display: grid;
    grid-template-columns: 280px 1fr 280px;
    gap: 12px;
    padding: 12px 0;
    min-height: calc(100vh - 64px);
  }

  @media (max-width: 1200px) {
    .main-grid { grid-template-columns: 1fr; }
  }

  /* PANELS */
  .panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .panel-header {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(0,212,255,0.03);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent);
  }

  .panel-badge {
    font-family: var(--font-mono);
    font-size: 9px;
    padding: 2px 8px;
    border: 1px solid currentColor;
    border-radius: 2px;
    letter-spacing: 1px;
  }

  .badge-green { color: var(--green); }
  .badge-warn { color: var(--warn); }
  .badge-red { color: var(--red); }

  /* WHALE LIST */
  .whale-item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(13,42,64,0.5);
    cursor: pointer;
    transition: background 0.15s;
    display: grid;
    grid-template-columns: 24px 1fr auto;
    gap: 10px;
    align-items: center;
  }

  .whale-item:hover { background: rgba(0,212,255,0.05); }
  .whale-item.active { background: rgba(0,212,255,0.08); border-left: 2px solid var(--accent); }

  .whale-rank {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
  }

  .whale-info { min-width: 0; }
  .whale-name { font-size: 12px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .whale-meta { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 1px; }

  .whale-win {
    text-align: right;
  }

  .win-rate {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
    color: var(--green);
  }

  .win-bar {
    width: 40px;
    height: 3px;
    background: rgba(0,255,157,0.2);
    border-radius: 2px;
    margin-top: 3px;
    overflow: hidden;
  }

  .win-fill {
    height: 100%;
    background: var(--green);
    border-radius: 2px;
    transition: width 1s ease;
  }

  /* CENTER PANEL */
  .center-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* TRADE CONTROLS */
  .controls-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 14px;
  }

  .control-group { display: flex; flex-direction: column; gap: 6px; }

  .control-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--muted);
  }

  .control-input {
    background: rgba(0,0,0,0.4);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 8px 10px;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    width: 100%;
    transition: border-color 0.2s;
    outline: none;
  }

  .control-input:focus { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(0,212,255,0.1); }

  .control-input.green { border-color: rgba(0,255,157,0.4); color: var(--green); }
  .control-input.red { border-color: rgba(255,59,92,0.4); color: var(--red); }
  .control-input.warn { border-color: rgba(255,215,0,0.4); color: var(--warn); }

  .input-prefix {
    position: relative;
  }

  .input-prefix::before {
    content: attr(data-prefix);
    position: absolute;
    left: 10px;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
    pointer-events: none;
  }

  .input-prefix input { padding-left: 26px; }

  /* TOGGLE SWITCH */
  .toggle-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(13,42,64,0.4);
    font-size: 12px;
  }

  .toggle-label { color: var(--muted); font-family: var(--font-mono); font-size: 10px; letter-spacing: 1px; }

  .toggle {
    position: relative;
    width: 36px;
    height: 18px;
    cursor: pointer;
  }

  .toggle input { opacity: 0; width: 0; height: 0; }

  .toggle-slider {
    position: absolute;
    inset: 0;
    background: rgba(13,42,64,0.8);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: 0.3s;
  }

  .toggle-slider::after {
    content: '';
    position: absolute;
    left: 2px; top: 2px;
    width: 12px; height: 12px;
    background: var(--muted);
    border-radius: 50%;
    transition: 0.3s;
  }

  .toggle input:checked + .toggle-slider { background: rgba(0,255,157,0.15); border-color: var(--green); }
  .toggle input:checked + .toggle-slider::after { transform: translateX(18px); background: var(--green); }

  /* BUTTONS */
  .btn-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 14px;
  }

  .btn {
    padding: 14px;
    border: none;
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 3px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }

  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(255,255,255,0.1);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .btn:hover::after { opacity: 1; }
  .btn:active { transform: scale(0.98); }

  .btn-buy {
    background: linear-gradient(135deg, rgba(0,255,157,0.2), rgba(0,255,157,0.1));
    border: 1px solid var(--green);
    color: var(--green);
    text-shadow: 0 0 20px rgba(0,255,157,0.5);
  }

  .btn-sell {
    background: linear-gradient(135deg, rgba(255,59,92,0.2), rgba(255,59,92,0.1));
    border: 1px solid var(--red);
    color: var(--red);
    text-shadow: 0 0 20px rgba(255,59,92,0.5);
  }

  .btn-full {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(0,212,255,0.15), rgba(0,212,255,0.05));
    border: 1px solid var(--accent);
    color: var(--accent);
    letter-spacing: 5px;
  }

  /* TICKER FEED */
  .ticker-wrap {
    overflow: hidden;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    background: rgba(0,212,255,0.02);
  }

  .ticker-scroll {
    display: flex;
    gap: 40px;
    animation: ticker 30s linear infinite;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .tick-item { display: flex; align-items: center; gap: 8px; }
  .tick-sym { color: var(--accent); font-weight: 600; }
  .tick-price { color: var(--text); }
  .tick-chg.up { color: var(--green); }
  .tick-chg.down { color: var(--red); }

  /* NEWS FEED */
  .news-item {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(13,42,64,0.4);
    cursor: pointer;
    transition: background 0.15s;
  }

  .news-item:hover { background: rgba(0,212,255,0.03); }

  .news-source {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .news-title {
    font-size: 11px;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 4px;
  }

  .news-meta {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .news-sentiment {
    padding: 1px 6px;
    border-radius: 2px;
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  .sent-bull { background: rgba(0,255,157,0.15); color: var(--green); }
  .sent-bear { background: rgba(255,59,92,0.15); color: var(--red); }
  .sent-neut { background: rgba(255,215,0,0.15); color: var(--warn); }

  /* PREDICTION CARDS */
  .pred-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    padding: 12px;
  }

  .pred-card {
    background: rgba(0,0,0,0.3);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .pred-card:hover {
    border-color: var(--accent);
    background: rgba(0,212,255,0.05);
  }

  .pred-sym {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--accent);
  }

  .pred-company { font-size: 9px; color: var(--muted); margin-bottom: 6px; }

  .pred-price {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
    margin-bottom: 4px;
  }

  .pred-target {
    font-family: var(--font-mono);
    font-size: 10px;
    display: flex;
    justify-content: space-between;
    margin-top: 4px;
  }

  .confidence-bar {
    height: 3px;
    background: rgba(0,0,0,0.4);
    border-radius: 2px;
    margin-top: 6px;
    overflow: hidden;
  }

  .conf-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    transition: width 1.5s ease;
  }

  /* PENNY STOCKS */
  .penny-item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(13,42,64,0.4);
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .penny-item:hover { background: rgba(255,107,53,0.05); }

  .penny-sym {
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 2px;
    color: var(--accent3);
    min-width: 60px;
  }

  .penny-info { flex: 1; min-width: 0; }
  .penny-name { font-size: 11px; color: var(--text); }
  .penny-price { font-family: var(--font-mono); font-size: 10px; color: var(--muted); }

  .penny-chg {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    text-align: right;
  }

  /* SIGNAL LOG */
  .signal-item {
    padding: 10px 14px;
    border-bottom: 1px solid rgba(13,42,64,0.3);
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: start;
    animation: fadeIn 0.5s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateX(-10px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .sig-type {
    width: 8px; height: 8px;
    border-radius: 50%;
    margin-top: 3px;
    flex-shrink: 0;
  }

  .sig-buy { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .sig-sell { background: var(--red); box-shadow: 0 0 6px var(--red); }
  .sig-warn { background: var(--warn); box-shadow: 0 0 6px var(--warn); }

  .sig-text { font-size: 11px; color: var(--text); line-height: 1.5; }
  .sig-sym { font-family: var(--font-mono); font-weight: 600; color: var(--accent); }
  .sig-time { font-family: var(--font-mono); font-size: 9px; color: var(--muted); white-space: nowrap; }

  /* PORTFOLIO STATS */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 4px;
    overflow: hidden;
  }

  .stat-cell {
    background: var(--card);
    padding: 12px 14px;
  }

  .stat-label { font-family: var(--font-mono); font-size: 9px; color: var(--muted); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px; }
  .stat-value { font-family: var(--font-display); font-size: 22px; letter-spacing: 1px; }
  .stat-sub { font-family: var(--font-mono); font-size: 9px; color: var(--muted); margin-top: 2px; }

  .val-green { color: var(--green); }
  .val-red { color: var(--red); }
  .val-blue { color: var(--accent); }
  .val-warn { color: var(--warn); }

  /* CHART PLACEHOLDER */
  .chart-area {
    padding: 14px;
    height: 140px;
    position: relative;
    overflow: hidden;
  }

  .chart-svg { width: 100%; height: 100%; }

  /* ALERT BANNER */
  .alert-banner {
    padding: 8px 14px;
    background: rgba(255,107,53,0.1);
    border-left: 3px solid var(--accent3);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent3);
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: alertPulse 2s ease-in-out infinite;
  }

  @keyframes alertPulse {
    0%, 100% { background: rgba(255,107,53,0.1); }
    50% { background: rgba(255,107,53,0.18); }
  }

  /* SOURCES ROW */
  .sources-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
  }

  .source-tag {
    font-family: var(--font-mono);
    font-size: 8px;
    letter-spacing: 1px;
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 2px;
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .source-tag:hover, .source-tag.active {
    border-color: var(--accent);
    color: var(--accent);
    background: rgba(0,212,255,0.05);
  }

  /* SLIPPAGE METER */
  .slip-meter {
    padding: 8px 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .slip-label { font-family: var(--font-mono); font-size: 9px; color: var(--muted); letter-spacing: 2px; min-width: 80px; }

  .slip-track {
    flex: 1;
    height: 4px;
    background: rgba(0,0,0,0.5);
    border-radius: 2px;
    overflow: hidden;
  }

  .slip-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--green), var(--warn), var(--red));
    transition: width 0.5s ease;
  }

  .slip-value { font-family: var(--font-mono); font-size: 10px; color: var(--warn); min-width: 40px; text-align: right; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
  ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

  .scroll-panel { overflow-y: auto; max-height: 360px; }
  .scroll-sm { overflow-y: auto; max-height: 220px; }
  .scroll-news { overflow-y: auto; max-height: 300px; }

  /* DISCLAIMER */
  .disclaimer {
    font-family: var(--font-mono);
    font-size: 8px;
    color: var(--muted);
    text-align: center;
    padding: 8px 14px;
    border-top: 1px solid var(--border);
    opacity: 0.6;
  }

  select.control-input {
    appearance: none;
    cursor: pointer;
  }

  .position-type {
    display: flex;
    gap: 6px;
    padding: 0 14px 10px;
  }

  .pos-btn {
    flex: 1;
    padding: 7px;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 3px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .pos-btn.active-long { border-color: var(--green); color: var(--green); background: rgba(0,255,157,0.08); }
  .pos-btn.active-short { border-color: var(--red); color: var(--red); background: rgba(255,59,92,0.08); }
  .pos-btn:hover { opacity: 0.8; }

  .rr-display {
    padding: 8px 14px;
    background: rgba(0,0,0,0.3);
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 10px;
  }

  .rr-label { color: var(--muted); }
  .rr-val { color: var(--warn); font-weight: 600; }
</style>
</head>
<body>
<div class="scanline"></div>

<header>
  <div class="container">
    <div class="header-inner">
      <div class="logo">
        <div class="logo-mark">🐋</div>
        <div>
          <div class="logo-text">LEVIATHAN</div>
          <div class="logo-sub">Whale Intelligence Trading System v3.1</div>
        </div>
      </div>

      <div class="status-bar">
        <div class="status-item">
          <div class="status-dot"></div>
          <span>LIVE FEED</span>
        </div>
        <div class="status-item">
          <div class="status-dot warn"></div>
          <span>NYSE OPEN</span>
        </div>
        <div class="status-item">
          <div class="status-dot"></div>
          <span>25 WHALES TRACKED</span>
