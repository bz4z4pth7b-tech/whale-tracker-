  document.getElementById('slipMeters').innerHTML = SLIPPAGES.map(s => `
    <div class="slip-meter">
      <span class="slip-label">${s.label}</span>
      <div class="slip-track"><div class="slip-fill" style="width:${s.pct*200}%"></div></div>
      <span class="slip-value">${s.pct.toFixed(2)}%</span>
    </div>
  `).join('');
}

function renderStats() {
  animateValue('pnl', 0, 18420, v => `+$${v.toLocaleString()}`);
  animateValue('winRate', 0, 84.7, v => `${v.toFixed(1)}%`);
  animateValue('sigCount', 0, 7, v => v);
  animateValue('riskExp', 0, 6.8, v => `${v.toFixed(1)}%`);
}

function animateValue(id, start, end, fmt) {
  const el = document.getElementById(id);
  const dur = 1500;
  const step = (end - start) / (dur / 16);
  let cur = start;
  const timer = setInterval(() => {
    cur = Math.min(cur + step, end);
    el.textContent = fmt(cur);
    if (cur >= end) clearInterval(timer);
  }, 16);
}

