// ─── TRADE CONTROLS ──────────────────────────────────────────────────────────

function setPos(btn, type) {
  document.querySelectorAll('.pos-btn').forEach(b => {
    b.className = 'pos-btn';
  });
  btn.className = `pos-btn active-${type === 'short' ? 'short' : 'long'}`;
}

function calcRR() {
  const entry = parseFloat(document.getElementById('entryPrice').value) || 0;
  const sl = parseFloat(document.getElementById('stopLoss').value) || 0;
  const tp = parseFloat(document.getElementById('takeProfit1').value) || 0;
  const size = parseFloat(document.getElementById('posSize').value) || 0;
  if (!entry || !sl || !tp) return;
  const risk = Math.abs(entry - sl) * size;
  const gain = Math.abs(tp - entry) * size;
  const rr = gain / risk;
  document.getElementById('rrRatio').textContent = `1 : ${rr.toFixed(2)}`;
  document.getElementById('maxRisk').textContent = `$${risk.toFixed(0)}`;
  document.getElementById('maxGain').textContent = `$${gain.toFixed(0)}`;
}

function executeTrade(side) {
  const sym = document.getElementById('symbolInput').value || 'NVDA';
  const entry = document.getElementById('entryPrice').value;
  const sl = document.getElementById('stopLoss').value;
  const tp = document.getElementById('takeProfit1').value;
  const size = document.getElementById('posSize').value;
  const slip = document.getElementById('slippageInput').value;

  const newSignal = {
    type: side === 'BUY' ? 'buy' : 'sell',
    sym,
    text: `Manual ${side} order placed at $${entry} | SL: $${sl} | TP: $${tp} | ${size} shares | Slippage: ${slip}%`,
    time: "just now"
  };

  SIGNALS.unshift(newSignal);
  if (SIGNALS.length > 10) SIGNALS.pop();
  renderSignals();

  document.getElementById('alertBanner').innerHTML =
    `✅ ${side} ORDER EXECUTED — ${sym} @ $${entry} | ${size} shares | SL: $${sl} | TP: $${tp} | Slippage: ${slip}%`;
}

